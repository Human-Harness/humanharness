{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "history": {
      "default": false,
      "type": "boolean"
    },
    "ui": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "version"
  ],
  "additionalProperties": false
}
