{
  "name": "humanharness",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json",
    "humanharness": "node packages/cli/bin/humanharness.js",
    "app:dev": "corepack pnpm --filter @humanharness/shell dev",
    "app:build": "corepack pnpm --filter @humanharness/shell build",
    "e2e": "corepack pnpm --filter @humanharness/e2e test"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
