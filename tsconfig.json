{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "paths": {
      "@humanharness/cli/sdk": ["./packages/cli/src/sdk.ts"],
      "@humanharness/cli/ui": ["./packages/cli/src/ui.ts"],
      // Only for the fake-agent quiz fixture's screen (packages/fake-agent/fixtures/input-harness/ui).
      "@humanharness/ui": ["./packages/ui/src/index.ts"]
    }
  },
  "include": ["packages/*/src", "packages/*/test", "packages/fake-agent/fixtures", "packages/e2e/tests", "packages/e2e/real", "packages/e2e/playwright.config.ts", "harnesses/*/*.ts", "harnesses/*/ui", "harnesses/*/test", "packages/cli/template/*.ts", "packages/cli/template/ui"]
}
