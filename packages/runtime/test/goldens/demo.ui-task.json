[
  {
    "name": "show_choices",
    "description": "Ends every answer: offers the person up to 4 ways to continue. `label` is what the person reads. An option with `followUp` stays on this topic (the app sends that text as the person's next message); `action` starts another topic by its id; `next: true` moves on to the next topic of the guided path. If an option has several, the app uses `action`, then `next`, then `followUp`; an option with only a `label` is a follow-up whose text is its label.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "options": {
          "minItems": 1,
          "maxItems": 4,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "followUp": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "action": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]*$"
              },
              "next": {
                "type": "boolean",
                "const": true
              }
            },
            "required": [
              "label"
            ]
          }
        }
      },
      "required": [
        "options"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "execution": {
      "taskSupport": "forbidden"
    }
  },
  {
    "name": "save_note",
    "description": "Saves what this topic made clear, only when the app asks you to close the topic. Write the note in English. The app writes it into the folder: never write it yourself. `summary`: at most 5 short key points; `decisions`: what was settled; `files`: paths that back the summary; `open`: questions left open.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "summary": {
          "minItems": 1,
          "maxItems": 5,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          }
        },
        "decisions": {
          "maxItems": 10,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          }
        },
        "files": {
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "open": {
          "maxItems": 10,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          }
        }
      },
      "required": [
        "title",
        "summary",
        "decisions",
        "files",
        "open"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "execution": {
      "taskSupport": "forbidden"
    }
  },
  {
    "name": "show_diagram",
    "description": "Shows a flow diagram: 2 to 7 boxes (nodes) in order, joined by arrows, and the edges that don't join neighbours listed under them. Use it at most once per answer, when a flow helps.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "nodes": {
          "minItems": 2,
          "maxItems": 7,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "detail": {
                "type": "string",
                "maxLength": 60
              }
            },
            "required": [
              "id",
              "label"
            ]
          }
        },
        "edges": {
          "maxItems": 10,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "minLength": 1
              },
              "to": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "maxLength": 120
              }
            },
            "required": [
              "from",
              "to"
            ]
          }
        }
      },
      "required": [
        "nodes",
        "edges"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "execution": {
      "taskSupport": "forbidden"
    }
  },
  {
    "name": "show_files",
    "description": "Lists the files where what you explained lives, each with a one-line role, so the person can open and check them. Paths are relative to the reference folder.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "files": {
          "minItems": 1,
          "maxItems": 8,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "role": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
            },
            "required": [
              "path",
              "role"
            ]
          }
        }
      },
      "required": [
        "files"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "execution": {
      "taskSupport": "forbidden"
    }
  }
]
