node_modules/
dist/
# The e2e test plugins are hand-written dist/ folders (no build step).
!packages/e2e/fixtures/plugins/*/dist/
# A harness's bundled plugins ship their built dist/ (a test checks it matches a fresh build).
!harnesses/*/plugins/*/dist/
# The tools e2e fixture's built tools (Decision 16; packages/cli/test/fixture-dist.test.ts checks it matches a fresh build).
!packages/fake-agent/fixtures/tools-harness/dist/
# The recipes e2e fixture's built tools (tools slice 4; packages/cli/test/recipes-fixture-dist.test.ts checks it).
!packages/fake-agent/fixtures/recipes-harness/dist/
# The terminal tool host's fixture (tools slice 5; packages/cli/test/tool-host-node.test.ts checks it).
!packages/cli/test/fixtures/tools-mini/dist/
# The build's swap folders (plugin-build.ts), left behind only by an interrupted build.
**/plugins/*/dist.tmp-*/
**/plugins/*/dist.old-*/
tmp-spike/
.DS_Store
*.log
out/
packages/e2e/.tmp/
test-results/
playwright-report/
.claude/
